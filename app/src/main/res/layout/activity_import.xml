<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabeçalho -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#1565C0"
            app:cardElevation="4dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄"
                    android:textSize="48sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Importar Produtos"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecione um arquivo .TXT para importar"
                    android:textSize="13sp"
                    android:textColor="#BBDEFB"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Formato do arquivo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FORMATO DO ARQUIVO"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="2dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Separador: ponto e vírgula ( ; )"
                        android:textSize="13sp"
                        android:textColor="#424242" />
                </LinearLayout>

                <!-- Header da tabela -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E3F2FD"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="EAN"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="COD"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text="DESCRIÇÃO"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="EST"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="PREÇO"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1" />
                </LinearLayout>

                <!-- Linha de exemplo 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFFFFF"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="7891234..."
                        android:textSize="11sp"
                        android:textColor="#424242"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="001"
                        android:textSize="11sp"
                        android:textColor="#424242"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text="Arroz 5kg"
                        android:textSize="11sp"
                        android:textColor="#424242"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="100"
                        android:textSize="11sp"
                        android:textColor="#424242"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="29.90"
                        android:textSize="11sp"
                        android:textColor="#424242"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Linha de exemplo 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#F9F9F9"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="7890000..."
                        android:textSize="11sp"
                        android:textColor="#424242"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="002"
                        android:textSize="11sp"
                        android:textColor="#424242"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text="Feijão 1kg"
                        android:textSize="11sp"
                        android:textColor="#424242"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="50"
                        android:textSize="11sp"
                        android:textColor="#424242"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:text="8.50"
                        android:textSize="11sp"
                        android:textColor="#424242"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Texto completo: EAN;CODIGO;DESCRICAO;ESTOQUE;PRECO"
                    android:textSize="11sp"
                    android:textColor="#757575"
                    android:fontFamily="monospace"
                    android:layout_marginTop="10dp"
                    android:background="#F5F5F5"
                    android:padding="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Seção de seleção -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ARQUIVO SELECIONADO"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Card do arquivo selecionado -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardArquivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄"
                    android:textSize="24sp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvArquivoSelecionado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nenhum arquivo selecionado"
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:ellipsize="middle"
                    android:singleLine="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botão selecionar arquivo -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelecionarArquivo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:text="Selecionar Arquivo TXT"
            android:textColor="#1565C0"
            app:icon="@drawable/ic_folder"
            app:iconTint="#1565C0"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#1565C0" />

        <!-- Botão importar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:text="Importar para o Banco Local"
            android:textColor="#FFFFFF"
            android:enabled="false"
            app:backgroundTint="#1565C0" />

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/progressImport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Resultado da importação -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#212121"
                android:gravity="center"
                android:padding="16dp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
